# ==============================================================================
# Verity — Environment Configuration Template
# ==============================================================================
# Copy this file to .env in your root directory:
#   cp .env.example .env
#
# All variables below have sensible defaults in code. If .env is missing or any
# variable is omitted, Verity runs out-of-the-box in local development mode.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Network Settings
# ------------------------------------------------------------------------------
# Port the FastAPI backend server listens on.
# Default: 8000 (If absent, uvicorn binds to port 8000)
PORT=8000

# Host interface to bind.
# Default: 0.0.0.0 (listens on all network interfaces)
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# Database Storage
# ------------------------------------------------------------------------------
# SQLAlchemy database connection string.
# Default: sqlite:///./verity.db
# If absent: Verity creates and uses a local SQLite database (verity.db) in the project
# root with zero external infrastructure or credentials required.
DATABASE_URL=sqlite:///./verity.db

# ------------------------------------------------------------------------------
# Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# Allowed origins for frontend API requests (comma-separated or JSON list).
# Default: http://localhost:5173,http://127.0.0.1:5173
# If absent: requests from the Vite development server on port 5173 are allowed.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# AI Explainer Service (Gemini API) — OPTIONAL
# ------------------------------------------------------------------------------
# Google Gemini API key used for natural-language root-cause explanations and
# cluster summaries.
#
# IMPORTANT — WHAT HAPPENS IF ABSENT OR EMPTY:
# If GEMINI_API_KEY is omitted, blank, or invalid:
#   1. The system NEVER blocks, throws a 500 error, or fails.
#   2. Verity automatically activates its deterministic TEMPLATE-FALLBACK engine.
#   3. Explanations and cluster summaries are generated instantly using grounded,
#      rule-based templates using exact financial impact, confidence, and rule numbers.
#   4. The response JSON indicates `"source": "template"` instead of `"LLM"`.
#   5. The entire reconciliation engine, glass-box UI, and audit logs remain 100% functional.
#
# To enable live LLM generation, set your API key below:
GEMINI_API_KEY=

# Gemini model identifier to invoke when GEMINI_API_KEY is provided.
# Default: gemini-2.5-flash
# If absent: defaults to gemini-2.5-flash for ultra-fast, low-latency structured JSON generation.
GEMINI_MODEL=gemini-2.5-flash
